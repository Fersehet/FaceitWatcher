# Kopiere diese Datei nach .env und trage deine Werte ein.

# Server-side API-Key von https://developers.faceit.com (App Studio -> API Keys).
# Leer lassen = Demo-Modus mit Beispieldaten.
FACEIT_API_KEY=

# Dein Faceit-Nickname (kann auch im Editor gesetzt werden).
FACEIT_NICKNAME=

# Port für Editor und Overlay (http://localhost:PORT)
PORT=3000

# Wie oft Faceit abgefragt wird (Sekunden)
POLL_INTERVAL_SECONDS=60

# Speicherort der Datenbank
DB_PATH=./data/faceitwatcher.db

# Domain der Landingpage (z. B. über Nginx Proxy Manager). Unter dieser Domain
# liefert der Server die Website aus. Den Editor gibt es dort nur nach Login
# (siehe ADMIN_PASSWORD), die Overlays nur lesend.
# Mehrere Domains mit Komma trennen. Lokal ist die Seite immer unter /site/ erreichbar.
SITE_HOST=
# Ordner der Website, Standard: website/ im Projektordner
SITE_DIR=


# Login für den Editor über die Website-Domain (SITE_HOST). Ohne Passwort ist
# der Editor dort gesperrt. Im Heimnetz (localhost, LAN-IP) braucht es keinen Login.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Optional: Schlüssel für die Login-Cookies (sonst automatisch in data/session-secret)
SESSION_SECRET=
