# Kopiere diese Datei nach .env und trage deine Werte ein.

# Server-side API-Key von https://developers.faceit.com (App Studio -> API Keys).
# Leer lassen = Demo-Modus mit Beispieldaten.
FACEIT_API_KEY=

# Dein Faceit-Nickname (kann auch im Editor gesetzt werden).
FACEIT_NICKNAME=

# Port für Editor und Overlay (http://localhost:PORT)
PORT=3000

# Wie oft Faceit abgefragt wird (Sekunden)
POLL_INTERVAL_SECONDS=60

# Speicherort der Datenbank
DB_PATH=./data/faceitwatcher.db
