# Kopiere diese Datei nach .env und trage deine Werte ein.

# Server-side API-Key von https://developers.faceit.com (App Studio -> API Keys).
# Leer lassen = Demo-Modus mit Beispieldaten.
FACEIT_API_KEY=

# Dein Faceit-Nickname (kann auch im Editor gesetzt werden).
FACEIT_NICKNAME=

# Port für Editor und Overlay (http://localhost:PORT)
PORT=3000

# Wie oft Faceit abgefragt wird (Sekunden)
POLL_INTERVAL_SECONDS=60

# Speicherort der Datenbank
DB_PATH=./data/faceitwatcher.db

# Optional: Ordner mit einer eigenen Startseite für /, Standard: website/ im Projektordner.
# Ohne Startseite führt / direkt zum Editor.
SITE_DIR=

# Login für den Editor (gilt überall, auch auf localhost). Ohne Passwort kann
# sich niemand anmelden. Overlays für OBS sind ohne Login lesbar.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Optional: Schlüssel für die Login-Cookies (sonst automatisch in data/session-secret)
SESSION_SECRET=
