# Kopiere diese Datei nach .env und trage deine Werte ein.

# Server-side API-Key von https://developers.faceit.com (App Studio -> API Keys).
# Leer lassen = Demo-Modus mit Beispieldaten.
FACEIT_API_KEY=

# Dein Faceit-Nickname (kann auch im Editor gesetzt werden).
FACEIT_NICKNAME=

# Port für Editor und Overlay (http://localhost:PORT)
PORT=3000

# Wie oft Faceit abgefragt wird (Sekunden)
POLL_INTERVAL_SECONDS=60

# Speicherort der Datenbank
DB_PATH=./data/faceitwatcher.db

# Domain der Landingpage (z. B. über Nginx Proxy Manager). Unter dieser Domain
# liefert der Server nur die Website aus, Editor und API bleiben privat.
# Mehrere Domains mit Komma trennen. Lokal ist die Seite immer unter /site/ erreichbar.
SITE_HOST=

# ---------- Discord-Bot (src/bot) ----------
# Variante A: eigener Bot (Token aus dem Discord Developer Portal, Channel-ID per Rechtsklick → "Kanal-ID kopieren")
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Variante B: statt Bot ein Channel-Webhook (Kanal bearbeiten → Integrationen → Webhooks)
DISCORD_WEBHOOK_URL=

# Adresse des FaceitWatcher-Servers (in docker-compose automatisch gesetzt)
FACEITWATCHER_URL=http://localhost:3000
